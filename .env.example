# Copy this file to .env and adjust as needed.
# .env is git-ignored — never commit real secrets.

# --- Database ---
# Used by docker-compose Postgres service and the backend.
POSTGRES_USER=adsec
POSTGRES_PASSWORD=adsec_dev_password
POSTGRES_DB=adsec_tracker
POSTGRES_PORT=5432

# Full SQLAlchemy URL the backend connects to.
# Postgres (Docker Compose - default deployment target):
DATABASE_URL=postgresql+psycopg://adsec:adsec_dev_password@db:5432/adsec_tracker

# SQLite zero-config local dev fallback (uncomment to use instead):
# DATABASE_URL=sqlite:///./app.db

# --- Backend ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload limits
MAX_UPLOAD_SIZE_MB=10

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=5173
