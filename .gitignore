# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
backend/venv/
backend/.venv/
venv/
.venv/
*.db
*.db.bak
*.sqlite
*.sqlite3
backend/app.db
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Local logs (operational only, but never committed) ---
logs/
*.log
backend/logs/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/build/
.vite/
*.local

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Real assessment data (never commit) ---
# Sanitized/synthetic demo files under sample-data/*.csv ARE tracked and
# meant to be committed — only real/local-only data paths are ignored here.
backend/uploads/
uploads/
data/
local-data/
real-data/
sample-data/real/
*.pentera.csv
*-real.csv

# Generated reports/exports (no such feature exists today, but if one is
# ever added, its output must never be committed by default).
reports/
exports/
*.report.csv
*.report.pdf

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Local agent/harness state (not project config) ---
.claude/

# --- Docker ---
docker-compose.override.yml
